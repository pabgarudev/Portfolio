---
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Analytics from "@vercel/analytics/astro";
import MobileMenu from "../components/MobileMenu.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import meImage from "../assets/me.png";
// Fonts
import '@fontsource-variable/onest'; // Supports weights 100-900
import '@fontsource-variable/jetbrains-mono'; // Secondary font, supports weights 100-800
// Preloaded so the correct font is used from first paint instead of flashing
// the fallback font while the (lazily-discovered, unicode-range-split) woff2 downloads.
import onestLatinWoff2 from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import jetbrainsMonoLatinWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description: string;
	image?: string | ImageMetadata;
	imageAlt?: string;
	structuredData?: object | object[];
}

const {
	title,
	description,
	image = "/og-image.png",
	imageAlt,
	structuredData,
} = Astro.props;

const extraSchemas = structuredData
	? (Array.isArray(structuredData) ? structuredData : [structuredData])
	: [];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// og:image/twitter:image default to the designed 1200x630 card (see
// scripts/generate-og-image.mjs), not the raw profile photo. The Person
// schema's `image` below stays on the actual photo on purpose — that
// field is read as an identity photo, not a share-card graphic.
const socialImageURL = new URL(typeof image === "string" ? image : image.src, Astro.site);
// The default card is the designed 1200x630 og-image.png; a page passing its
// own ImageMetadata (project pages) carries real intrinsic dimensions.
const socialImageWidth = typeof image === "string" ? 1200 : image.width;
const socialImageHeight = typeof image === "string" ? 630 : image.height;
const socialImageAlt = imageAlt ?? title;
const personImageURL = new URL(meImage.src, Astro.site);

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	// Stable node id so per-page BlogPosting/breadcrumb schemas can reference
	// this one Person by @id instead of restating a partial copy.
	"@id": new URL("/#person", Astro.site).toString(),
	name: "Pablo García Ruiz",
	url: Astro.site?.toString(),
	image: personImageURL.toString(),
	jobTitle: "Computer Vision Engineer",
	description,
	worksFor: {
		"@type": "Organization",
		name: "Indra Group",
	},
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "University of Córdoba",
	},
	sameAs: [
		"https://www.linkedin.com/in/pablo-garc%C3%ADa-ruiz-9640332a3/",
		"https://github.com/pabgaru/",
		"https://orcid.org/0009-0009-4483-9258",
		"https://scholar.google.com/citations?user=stA5POMAAAAJ&hl=es",
	],
	knowsAbout: [
		"Computer Vision",
		"Object Detection",
		"Pose Estimation",
		"3D Reconstruction",
		"Artificial Intelligence",
	],
	address: {
		"@type": "PostalAddress",
		addressLocality: "Córdoba",
		addressCountry: "ES",
	},
};
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Blocking, runs before first paint: a manually-chosen theme
			// (stored by themeToggle.ts) wins if present; otherwise the theme
			// derives from the OS preference (dark preference -> dark, everything
			// else, including "no preference" -> light). Deliberately not re-run
			// on Astro view-transition navigations (it's a real <head> script,
			// and those don't fire again on client-side nav) -- in-tab
			// navigation restores the live value via the astro:*-swap listeners
			// below, and a hard reload re-reads localStorage/OS here.
			(function () {
				function applyMeta(theme) {
					var meta = document.querySelector('meta[name="theme-color"]');
					if (meta) meta.setAttribute("content", theme === "dark" ? "#0a0a0a" : "#fafafa");
				}

				var stored = null;
				try {
					stored = localStorage.getItem("theme");
				} catch (e) {}

				var theme;
				if (stored === "dark" || stored === "light") {
					theme = stored;
				} else {
					var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					theme = prefersDark ? "dark" : "light";
				}
				document.documentElement.dataset.theme = theme;
				applyMeta(theme);

				// Astro's client-side swap resets every attribute on <html> to
				// match the freshly-fetched page (swap-functions.js's
				// swapRootAttributes removes anything not present on the new
				// document's <html> tag) — and data-theme only ever exists
				// client-side, so it's wiped on every in-tab navigation. Nothing
				// re-derives it afterward (that's the point of not re-running this
				// script), so everything reading dataset.theme after a nav — the 3D
				// icons' color, confetti colors, --ink — silently fell back to its
				// dark-mode default. Snapshot the live value right before each
				// swap wipes it, then restore it right after, before
				// astro:page-load runs and anything rebuilds off of it.
				document.addEventListener("astro:before-swap", function () {
					theme = document.documentElement.dataset.theme || theme;
				});
				document.addEventListener("astro:after-swap", function () {
					document.documentElement.dataset.theme = theme;
					applyMeta(theme);
				});
			})();
		</script>
		<link rel="preload" href={onestLatinWoff2} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={jetbrainsMonoLatinWoff2} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" type="application/rss+xml" title="Pablo García Ruiz - Blog" href={new URL("/rss.xml", Astro.site)} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="author" content="Pablo García Ruiz" />

		<!-- Open Graph / Facebook, LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Pablo García Ruiz - Portfolio" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content={String(socialImageWidth)} />
		<meta property="og:image:height" content={String(socialImageHeight)} />
		<meta property="og:image:alt" content={socialImageAlt} />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={socialImageAlt} />

		<!-- Structured data -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
		{extraSchemas.map((schema) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
		))}

		<ClientRouter />
	</head>
	<body ontouchstart="">
		<a href="#main-content" class="skip-link">Skip to content</a>
		<div class="fixed inset-0 z-[-2] min-h-dvh w-full bg-neutral-50 dark:bg-neutral-950" transition:persist></div>
		<div class="page-scan-grid pointer-events-none fixed inset-0 z-[-1] min-h-dvh w-full" id="page-scan-grid" aria-hidden="true" transition:persist></div>
		<Header />
		<MobileMenu />
		<slot />
		<Footer />
		<Analytics />
	</body>
</html>

<noscript>
	<style>
		.icon3d-canvas { display: none !important; }
		.icon3d-fallback { display: inline-block !important; }
	</style>
</noscript>

<style is:global>

	:root[data-theme="dark"] {
		color-scheme: dark;
		--ink: white;
		--accent-green: #00e08f;
	}

	:root[data-theme="light"] {
		color-scheme: light;
		--ink: black;
		/* The bright dark-mode green (#00e08f) has poor contrast as text on a
		   white background; this deeper, more saturated variant stays legible
		   there while still reading as "green" rather than a washed-out pastel. */
		--accent-green: #00875a;
		/* Every light-mode text/border/bg opacity utility in this codebase
		   (text-neutral-950/70, border-neutral-950/10, etc.) is built on this
		   token — every one of those is a light-mode-only slot (its dark-mode
		   counterpart is a separate dark:text-white/N class), so retinting it
		   here can't touch dark mode at all. Overriding it to a deep violet
		   instead of Tailwind's plain neutral-950 is what turns every one of
		   those "gray" secondary-text/border instances into a violet-tinted
		   ink, site-wide, without editing every file that uses them. */
		--color-neutral-950: #332f52;
	}

	html{
		font-family: 'Onest Variable', sans-serif;
		scroll-behavior: smooth;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
		overflow-x: hidden;
	}

	:root[data-theme="dark"] body {
		background: #0a0a0a;
	}

	:root[data-theme="light"] body {
		background: #fafafa;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	.skip-link {
		position: fixed;
		top: 1rem;
		left: 1rem;
		z-index: 1100;
		transform: translateY(-150%);
		background: white;
		color: black;
		padding: 0.625rem 1.25rem;
		border-radius: 9999px;
		font-size: 0.875rem;
		font-weight: 600;
		transition: transform 0.15s ease-out;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.page-scan-grid {
		--cell-px: 64px;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(var(--cell-px), 1fr));
		align-content: start;
		/* Concentrated behind the hero, like the old glow was, then fades out
		   so it doesn't tile as a hard grid behind every section/card below. */
		mask-image: linear-gradient(to bottom, #fff 0, #fff 420px, transparent 900px);
		-webkit-mask-image: linear-gradient(to bottom, #fff 0, #fff 420px, transparent 900px);
	}

	@media (max-width: 639px) {
		.page-scan-grid {
			--cell-px: 48px;
		}
	}

	.page-scan-cell {
		aspect-ratio: 1 / 1;
		background: #7877c6;
		opacity: 0;
		transition: opacity 1.8s ease-in-out, background-color 1.8s ease-in-out;
	}

	@media (prefers-reduced-motion: reduce) {
		.page-scan-cell {
			display: none;
		}
	}
</style>

<script>
document.addEventListener("astro:page-load", () => {
	// The grid div is `transition:persist`, so it survives view-transition
	// navigations and this listener fires again on every one: guard so the
	// cells are only ever built (and their twinkle loops started) once.
	const grid = document.getElementById("page-scan-grid");
	if (!grid || grid.dataset.filled === "true") return;

	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	if (prefersReducedMotion) return;

	grid.dataset.filled = "true";

	const twinkle = (cell: HTMLElement, first = true) => {
		const tick = (isFirst: boolean) => {
			// Dark theme: every cell sits at a low, steady-ish glow (reads as
			// stars against near-black). That same low alpha against a light
			// page has no dark sink to glow against, so it just looks like a
			// faint uniform wash — light theme instead keeps most cells fully
			// off and lets a few flash brighter at a time, which reads as
			// actual sparse twinkling instead of a static tint.
			if (document.documentElement.dataset.theme === "light") {
				cell.style.opacity = "0";
				// The steady-state gap is long on purpose (sparse twinkling), but
				// that same long gap made the very first flash take ages to show
				// up on page load, so only the first cycle uses a short wait.
				const wait = isFirst ? 300 + Math.random() * 900 : 5000 + Math.random() * 9000;
				window.setTimeout(() => {
					cell.style.opacity = (0.12 + Math.random() * 0.1).toFixed(3);
					window.setTimeout(() => tick(false), 700 + Math.random() * 1100);
				}, wait);
				return;
			}
			cell.style.opacity = (0.055 + Math.random() * 0.075).toFixed(3);
			window.setTimeout(() => tick(false), 1600 + Math.random() * 2800);
		};
		window.setTimeout(() => tick(first), Math.random() * 400);
	};

	const fill = () => {
		// Read live (rather than a hardcoded constant) since the --cell-px
		// custom property changes at the mobile breakpoint, and this runs
		// again on resize.
		const cellPx = parseFloat(getComputedStyle(grid).getPropertyValue("--cell-px")) || 64;
		const { width, height } = grid.getBoundingClientRect();
		const cols = Math.max(1, Math.round(width / cellPx));
		const needed = cols * Math.ceil(height / cellPx);
		for (let i = grid.childElementCount; i < needed; i++) {
			const cell = document.createElement("span");
			cell.className = "page-scan-cell";
			grid.appendChild(cell);
			twinkle(cell);
		}
	};

	fill();
	window.addEventListener("resize", fill);
});
</script>

<script>
// Turns every section-heading icon on the page (see Icon3D.astro) into a
// solid, gently floating 3D mesh. Run from the shared layout, not each
// page, so every page that uses <Icon3D> gets the same live behavior.
import { initIcon3DSlots } from "../lib/icon3dRuntime";

document.addEventListener("astro:page-load", initIcon3DSlots);
</script>

<script>
import { initThemeToggle } from "../lib/themeToggle";

document.addEventListener("astro:page-load", initThemeToggle);
</script>
