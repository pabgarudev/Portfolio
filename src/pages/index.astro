---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import Display from '../components/Display.astro';
import Button from '../components/Button.astro';
import meImage from '../assets/me.png';
// Icons
import LinkedInIcon from '../components/icons/LinkedIn.astro';
import GitHubIcon from '../components/icons/GitHub.astro';
import MailIcon from '../components/icons/Mail.astro';
import ContactIcon from '../components/icons/ContactIcon.astro';
import AboutMeIcon from '../components/icons/AboutMeIcon.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Icon3D from '../components/Icon3D.astro';
import Suitcase from '../components/icons/Suitcase.astro';
import GraduationCap from '../components/icons/GraduationCap.astro';
import Code from '../components/icons/Code.astro';
import Book from '../components/icons/Book.astro';
import Quote from '../components/icons/Quote.astro';
import Contact from '../components/Contact.astro';
import AboutMe from '../components/AboutMe.astro';
import TeaserCard from '../components/TeaserCard.astro';
import Testimonials from '../components/Testimonials.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArrowRight from '../components/icons/ArrowRight.astro';
import Gear from '../components/icons/Gear.astro';
import { PROJECTS } from '../data/projects';

const pinnedProjects = PROJECTS.filter((project) => project.pinned);

---

<Layout
	title="Pablo García Ruiz - Computer Vision Engineer & PhD"
	description="Pablo García Ruiz is a PhD in Computer Vision with 4+ years of experience in object detection, pose estimation and 3D reconstruction. Based in Córdoba, Spain, available for freelance and side gigs."
	image={meImage}>
	<main id="main-content" class="px-5 sm:px-8">

		<SectionContainer class="pt-28 sm:pt-36 lg:pt-44 pb-12">

			<div class="face-reveal-scene relative inline-block mb-5">
				<Image
					src={meImage}
					width={320}
					alt="Pablo García Ruiz, Computer Vision Engineer"
					fetchpriority="high"
					loading="eager"
					format="webp"
					class="rounded-full size-36 lg:size-40 block"
				/>
				<span class="reveal-box" id="face-box" aria-hidden="true">
					<span class="face-grid" aria-hidden="true">
						<span class="face-cell"></span>
						<span class="face-cell"></span>
						<span class="face-cell"></span>
						<span class="face-cell"></span>
						<span class="face-cell"></span>
						<span class="face-cell"></span>
						<span class="face-cell"></span>
						<span class="face-cell"></span>
						<span class="face-cell"></span>
					</span>
				</span>
				<span class="reveal-label" id="face-label" aria-hidden="true"></span>
			</div>

			<h1 class="reveal-scene text-white text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight pb-4 lg:pb-10 leading-snug" aria-label="Hi, I’m Pablo García Ruiz">
				Hi, I’m <span class="reveal-word" data-word data-label="name 0.99">Pablo</span> <span class="reveal-word" data-word data-label="surname 0.97">García</span> <span class="reveal-word whitespace-nowrap" data-word data-label="surname 0.99">Ruiz</span>
				<span class="reveal-caret" aria-hidden="true"></span>
				<span class="reveal-label name-label" aria-hidden="true"></span>
				<span class="reveal-label name-label" aria-hidden="true"></span>
			</h1>
			<a
				class="flex flex-wrap justify-start items-start gap-2 pb-8"
				href="#contact"
				>
				<span id="available-badge" class="badge-reveal">
					<Badge>Available for Work</Badge>
				</span>
				<!-- Zero-size, full-basis spacer: forces the pill after it onto its
				     own line below sm, without stretching the pill itself to fill
				     the row (which a plain w-full on the pill would do). -->
				<span class="basis-full sm:hidden" aria-hidden="true"></span>
				<span class="freelance-tag inline-flex items-center gap-3 rounded bg-[#ff004f]/15 text-xs font-mono font-medium px-3 py-1" style="color: color-mix(in srgb, white 30%, #ff004f 70%);">
					<span class="gear-slot shrink-0" aria-hidden="true">
						<canvas id="gear-canvas" class="gear-canvas" width="32" height="32"></canvas>
						<Gear id="gear-fallback" class="gear-fallback" />
					</span>
					Freelance & Side Gigs
				</span>
			</a>
			<p class="text-base lg:text-xl opacity-85 text-wrap max-w-full sm:max-w-[600px] leading-relaxed">
				<b>Doctor in Computer Vision</b> <span style="color: #ff004f;">•</span> 4+ years experience <span style="color: #ff004f;">•</span> Expert in object detection, pose estimation & 3D reconstruction <span style="color: #ff004f;">•</span> <span><b>From Córdoba, Spain</b></span> <span style="color: #ff004f;">•</span> Currently building vision systems for defense & aerospace at Indra
			</p>
			<div class="mt-3 max-w-full sm:max-w-[600px] rounded-2xl border border-[#7877c6]/20 bg-[#7877c6]/10 px-4 py-3">
	<p class="text-sm sm:text-base text-white/80 leading-relaxed">
		Open to app development, visual branding & motion design and general CV/ML consulting. <b class="font-bold" style="color: color-mix(in srgb, white 10%, #ff004f);">Basically, if it's interesting, I'm in.</b>
	</p>
</div>

			<!-- List of link badges -->
			<nav class="flex gap-4 mt-6 flex-wrap">
				<!-- Obtained in: https://svgl.app/?search=linkdin -->
				<!-- LinkedIn -->
				<Button href="https://www.linkedin.com/in/pablo-garc%C3%ADa-ruiz-9640332a3/" icon={LinkedInIcon} external>
					LinkedIn
				</Button>
				<!-- GitHub -->
				<Button href="https://github.com/pabgaru/" icon={GitHubIcon} external>
					Github
				</Button>
				<!-- Mail -->
				<Button href="mailto:pabgarudev@gmail.com" icon={MailIcon} external>
					pabgarudev@gmail.com
				</Button>
			</nav>
		</SectionContainer>

		<SectionContainer id="experience" class="py-12 pb-12">
			<h2 class="text-2xl font-semibold tracking-tight flex gap-x-3 items-center pb-5">
				<Icon3D id="icon3d-suitcase" rotation={[-0.45, 0.4, 0.12]}>
					<Suitcase class="icon3d-fallback size-11" />
				</Icon3D>
				Work experience
			</h2>
			<Experience></Experience>
		</SectionContainer>

		<SectionContainer id="testimonials" class="py-12 pb-12">
			<h2 class="text-2xl font-semibold tracking-tight flex gap-x-3 items-center pb-5">
				<Icon3D id="icon3d-quote" rotation={[-0.35, -0.32, -0.15]}>
					<Quote class="icon3d-fallback size-11" />
				</Icon3D>
				What people say
			</h2>
			<Testimonials></Testimonials>
		</SectionContainer>

		<SectionContainer id="projects" class="py-12 pb-6">
			<h2 class="text-2xl font-semibold tracking-tight flex gap-x-3 items-center pb-5">
				<Icon3D id="icon3d-code" rotation={[-0.5, 0.5, 0.18]}>
					<Code class="icon3d-fallback size-11" />
				</Icon3D>
				Projects
			</h2>
			<p class="max-w-[640px] text-sm sm:text-base text-white/60 leading-relaxed">
				From peer-reviewed papers and my Ph.D. thesis to fully open-sourced workshops: the research and hands-on work behind my Computer Vision career.
			</p>
		</SectionContainer>

		<section class="scroll-mt-24 w-full max-w-[1120px] mx-auto pb-12">
			<p class="mb-3 text-xs font-semibold uppercase tracking-wider text-white/50">
				A few pinned highlights
			</p>

			<div
				id="pinned-projects-track"
				class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:grid lg:grid-cols-3 lg:gap-5 lg:overflow-visible lg:snap-none lg:pb-0"
			>
				{
					pinnedProjects.map((project) => (
						<div class="w-full shrink-0 snap-start lg:contents">
							<ProjectCard {...project} year={String(project.year)} />
						</div>
					))
				}
			</div>

			{
				pinnedProjects.length > 1 && (
					<div class="mt-3 flex justify-center lg:hidden">
						<div class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-neutral-950 p-1 shadow-lg shadow-black/40 backdrop-blur-sm">
							<button
								id="pinned-projects-prev"
								type="button"
								aria-label="Previous pinned project"
								class="inline-flex size-8 items-center justify-center rounded-full font-mono text-sm text-white transition hover:scale-110 hover:bg-[#7877c6]/15"
							>
								{"<"}
							</button>
							<span id="pinned-projects-counter" class="min-w-[3ch] px-1 text-center font-mono text-xs tabular-nums text-white/40">
								1 / {pinnedProjects.length}
							</span>
							<button
								id="pinned-projects-next"
								type="button"
								aria-label="Next pinned project"
								class="inline-flex size-8 items-center justify-center rounded-full font-mono text-sm tracking-widest text-white transition hover:scale-110 hover:bg-[#7877c6]/15"
							>
								{"/>"}
							</button>
						</div>
					</div>
				)
			}

			<div class="mt-6 flex justify-center">
				<Button href="/projects/">
					View all {PROJECTS.length} projects
					<ArrowRight class="size-4" />
				</Button>
			</div>
		</section>

		<script>
		document.addEventListener("astro:page-load", () => {
			const track = document.getElementById("pinned-projects-track");
			const prevBtn = document.getElementById("pinned-projects-prev") as HTMLButtonElement | null;
			const nextBtn = document.getElementById("pinned-projects-next") as HTMLButtonElement | null;
			const counter = document.getElementById("pinned-projects-counter");
			const pageCount = track?.children.length ?? 0;

			if (!track || !prevBtn || !nextBtn) return;

			// Circular: paging past either end wraps around to the other side
			// instead of stopping, matching the testimonials carousel.
			const scrollByPage = (dir: 1 | -1) => {
				const maxScroll = track.scrollWidth - track.clientWidth;
				if (dir === 1 && track.scrollLeft >= maxScroll - 4) {
					track.scrollTo({ left: 0, behavior: "smooth" });
				} else if (dir === -1 && track.scrollLeft <= 4) {
					track.scrollTo({ left: maxScroll, behavior: "smooth" });
				} else {
					track.scrollBy({ left: dir * track.clientWidth, behavior: "smooth" });
				}
			};

			prevBtn.addEventListener("click", () => scrollByPage(-1));
			nextBtn.addEventListener("click", () => scrollByPage(1));

			if (counter && pageCount > 0) {
				let scrollTimer: number | undefined;
				const updateCounter = () => {
					const page = Math.round(track.scrollLeft / track.clientWidth);
					const clamped = Math.min(Math.max(page, 0), pageCount - 1);
					counter.textContent = `${clamped + 1} / ${pageCount}`;
				};
				track.addEventListener("scroll", () => {
					window.clearTimeout(scrollTimer);
					scrollTimer = window.setTimeout(updateCounter, 80);
				});
			}
		});
		</script>

		<SectionContainer id="education" class="py-12 pb-12">
			<h2 class="text-2xl font-semibold tracking-tight flex gap-x-3 items-center pb-5">
				<Icon3D id="icon3d-graduationcap" rotation={[-0.3, -0.42, 0.1]}>
					<GraduationCap class="icon3d-fallback size-11" />
				</Icon3D>
				Education
			</h2>
			<Education></Education>
		</SectionContainer>

		<SectionContainer id="blog" class="py-12 pb-12">
			<h2 class="text-2xl font-semibold tracking-tight flex gap-x-3 items-center pb-5">
				<Icon3D id="icon3d-book" rotation={[-0.52, 0.22, -0.2]}>
					<Book class="icon3d-fallback size-11" />
				</Icon3D>
				Blog
			</h2>

			<TeaserCard
				href="/blog/"
				description="Notes on the roles I've held, the research behind them, and what Computer Vision engineering actually looks like day to day."
				buttonText="Read the blog"
			/>
		</SectionContainer>

		<SectionContainer id="about-me" class="py-12 pb-20">
			<h2 class="text-2xl font-semibold tracking-tight flex gap-x-3 items-center pb-5">
				<Icon3D id="icon3d-aboutme" rotation={[-0.4, 0.32, 0.15]} class="size-11 scale-x-[-1]">
					<AboutMeIcon class="icon3d-fallback size-11" />
				</Icon3D>
				About me
			</h2>
			<AboutMe />
		</SectionContainer>

		<SectionContainer id="contact" class="py-12 pb-20">
			<h2 class="text-2xl font-semibold tracking-tight flex gap-x-3 items-center pb-5">
				<Icon3D id="icon3d-contact" rotation={[-0.35, -0.48, -0.1]}>
					<ContactIcon class="icon3d-fallback size-11" />
				</Icon3D>
				Contact
			</h2>
			<Contact />
		</SectionContainer>
	</main>
</Layout>

<noscript>
	<style>
		.reveal-box, .reveal-caret, .reveal-label { display: none !important; }
		.badge-reveal { opacity: 1 !important; max-width: none !important; }
		.gear-canvas { display: none !important; }
		.gear-fallback { display: inline-block !important; }
	</style>
</noscript>

<style>
	.reveal-scene {
		position: relative;
	}

	/* Cursor-driven 3D tilt on the hero photo (see src/lib/tilt.ts and the
	   script below). The face-box overlay has no transform of its own, so it
	   rides along inside this element's tilted 3D space automatically. */
	.face-reveal-scene {
		transition: transform 0.15s ease-out;
		will-change: transform;
	}

	@media (prefers-reduced-motion: reduce) {
		.face-reveal-scene {
			transition: none;
		}
	}

	.reveal-word {
		display: inline-block;
	}

	.reveal-word .char {
		transition: color 0.5s ease-out;
	}

	.reveal-word .char.char-hit {
		color: #ff004f;
		transition: color 0.08s ease-out;
	}

	.reveal-box {
		position: absolute;
		border: 2.5px solid #ff004f;
		border-radius: 0;
		pointer-events: none;
		opacity: 0;
	}

	.reveal-caret {
		position: absolute;
		width: 2px;
		background: #ff004f;
		pointer-events: none;
		opacity: 0;
	}

	.reveal-caret.blinking {
		animation: caret-blink 1.1s steps(1, jump-none) infinite;
	}

	@keyframes caret-blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	.face-grid {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-template-rows: repeat(3, 1fr);
		pointer-events: none;
	}

	.face-cell {
		background: #ff004f;
		opacity: 0;
		transition: opacity 0.4s ease-in-out;
	}

	.reveal-label {
		position: absolute;
		transform: translateY(-100%);
		margin-top: 0;
		padding: 1px 4px;
		background: #ff004f;
		color: white;
		font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
		font-size: 10px;
		font-weight: 700;
		line-height: 1.5;
		border-radius: 0;
		white-space: nowrap;
		pointer-events: none;
		letter-spacing: 0.02em;
		opacity: 0;
	}

	.reveal-label.name-label {
		transform: translate(-100%, -100%);
	}

	/* Surname label only: on narrow screens the name can wrap, so the label
	   flips to bottom-right of the caret instead of top-left to avoid
	   overlapping the wrapped line above it. Only the Y axis flips (anchored
	   at the caret's bottom, pulled back up by its own height) so the label
	   stays within the caret's height band and reads as "to the right"
	   rather than stacked underneath it. */
	.reveal-label.name-label.label-flip {
		transform: translateY(-100%);
	}

	.badge-reveal {
		display: inline-flex;
		max-width: 0;
		opacity: 0;
		overflow: hidden;
		white-space: nowrap;
		vertical-align: top;
		transition: max-width 0.45s ease-out, opacity 0.35s ease-out;
	}

	.badge-reveal.is-shown {
		max-width: var(--badge-w, 260px);
		opacity: 1;
	}

	.freelance-tag {
		transition: box-shadow 0.25s ease-out, transform 0.25s ease-out;
	}

	.freelance-tag:hover, .freelance-tag:focus-visible {
		box-shadow: 0 4px 18px -6px rgba(255, 0, 79, 0.55);
		transform: translateY(-1px);
	}

	/* Gear icon is a WebGL-rendered mesh (real extruded geometry, lit and
	   rotated by an actual camera), not a CSS illusion. .gear-slot is a
	   small fixed footprint that keeps the pill's own height/spacing exactly
	   what it'd be for a normal inline icon; the canvas itself is bigger and
	   absolutely centered on that footprint, so it overflows above/below the
	   pill instead of stretching it. .gear-fallback is the flat icon shown
	   instead when WebGL init fails or JS never runs (see the gear-init
	   script below and the <noscript> block above). */
	.gear-slot {
		position: relative;
		display: inline-block;
		width: 16px;
		height: 16px;
	}

	.gear-canvas {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 32px;
		height: 32px;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.gear-fallback {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 20px;
		height: 20px;
		transform: translate(-50%, -50%);
		display: none;
	}

	.freelance-tag.gear-fallback-active .gear-canvas {
		display: none;
	}

	.freelance-tag.gear-fallback-active .gear-fallback {
		display: inline-block;
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal-box, .reveal-caret, .reveal-label {
			display: none;
		}

		.badge-reveal {
			opacity: 1;
			max-width: none;
			transition: none;
		}

		.freelance-tag {
			transition: box-shadow 0.25s ease-out;
		}

		.freelance-tag:hover, .freelance-tag:focus-visible {
			transform: none;
		}
	}
</style>

<script>
document.addEventListener("astro:page-load", () => {
	const CARET_PAD_V = 3;
	const LABEL_OFFSET_X = 3;
	const CARET_END_NUDGE_X = 4;
	const START_DELAY_MS = 400;
	const CARET_JUMP_MS = 100;
	const CHAR_STEP_MS = 45;
	const LABEL_IN_MS = 150;
	const DWELL_MS = 500;
	const FINAL_EXTRA_MS = 300;

	const scene = document.querySelector<HTMLElement>(".reveal-scene");
	const caret = scene?.querySelector<HTMLElement>(".reveal-caret") ?? null;
	// One label per word group (name, surname) so both can stay visible at once
	// instead of sharing/reusing a single element.
	const labelEls = scene ? Array.from(scene.querySelectorAll<HTMLElement>(".name-label")) : [];
	const words = Array.from(document.querySelectorAll<HTMLElement>("[data-word]"));
	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const wordChars = words.map(splitIntoChars);

	function wait(ms: number) {
		return new Promise<void>((resolve) => setTimeout(resolve, ms));
	}

	function splitIntoChars(word: HTMLElement) {
		// Astro's scoped styles rely on a data-astro-cid-* attribute; spans created
		// here at runtime need it copied over or the scoped .char rules won't match.
		const scopeAttr = word.getAttributeNames().find((name) => name.startsWith("data-astro-cid"));

		const text = word.textContent ?? "";
		word.textContent = "";
		const chars: HTMLElement[] = [];
		for (const ch of text) {
			const charEl = document.createElement("span");
			charEl.className = "char";
			charEl.textContent = ch;
			charEl.setAttribute("aria-hidden", "true");
			if (scopeAttr) charEl.setAttribute(scopeAttr, "");
			word.appendChild(charEl);
			chars.push(charEl);
		}
		return chars;
	}

	function flashChar(charEl: HTMLElement) {
		charEl.classList.add("char-hit");
		window.setTimeout(() => charEl.classList.remove("char-hit"), 260);
	}

	function rectOf(el: HTMLElement, sceneEl: HTMLElement, atRightEdge = false) {
		const sceneRect = sceneEl.getBoundingClientRect();
		const elRect = el.getBoundingClientRect();
		return {
			left: (atRightEdge ? elRect.right : elRect.left) - sceneRect.left,
			top: elRect.top - sceneRect.top - CARET_PAD_V,
			height: elRect.height + CARET_PAD_V * 2,
		};
	}

	function placeCaret(caretEl: HTMLElement, labelEl: HTMLElement, rect: ReturnType<typeof rectOf>, durationMs: number, flip = false) {
		const transition = durationMs > 0
			? `left ${durationMs}ms linear, top ${durationMs}ms linear, height ${durationMs}ms linear`
			: "none";

		caretEl.style.transition = transition;
		caretEl.style.left = `${rect.left}px`;
		caretEl.style.top = `${rect.top}px`;
		caretEl.style.height = `${rect.height}px`;

		labelEl.classList.toggle("label-flip", flip);
		labelEl.style.transition = transition;
		labelEl.style.left = `${rect.left + LABEL_OFFSET_X}px`;
		labelEl.style.top = `${flip ? rect.top + rect.height : rect.top}px`;
	}

	// Pablo gets its own pass; García + Ruiz sweep as one continuous pass with a
	// single trailing label (they're both "surname", no need to call it out twice).
	const WORD_GROUPS: number[][] = [[0], [1, 2]];

	async function run(sceneEl: HTMLElement, caretEl: HTMLElement, labelEls: HTMLElement[]) {
		await wait(START_DELAY_MS);

		placeCaret(caretEl, labelEls[0], rectOf(wordChars[0][0], sceneEl), 0);
		void caretEl.offsetWidth;

		caretEl.style.transition = "opacity 0.2s ease-out";
		caretEl.style.opacity = "1";

		for (let g = 0; g < WORD_GROUPS.length; g++) {
			const groupIndices = WORD_GROUPS[g];
			const groupChars = groupIndices.flatMap((wordIndex) => wordChars[wordIndex]);
			const lastWord = words[groupIndices[groupIndices.length - 1]];
			const labelEl = labelEls[g];
			// Surname label only: flip to bottom-right when its own words actually
			// wrapped onto a new line (checked by comparing the group's first and
			// last word tops) — if it still fits on one line, it stays top-left
			// just like the name label, regardless of viewport width.
			const firstWordTop = words[groupIndices[0]].getBoundingClientRect().top;
			const lastWordTop = words[groupIndices[groupIndices.length - 1]].getBoundingClientRect().top;
			const groupWrapped = lastWordTop > firstWordTop + 4;
			const flip = g === WORD_GROUPS.length - 1 && groupWrapped;

			if (g > 0) {
				// Caret already faded out at the end of the previous group: jump to this
				// group's start while invisible, then fade back in (no slide across the gap).
				placeCaret(caretEl, labelEl, rectOf(groupChars[0], sceneEl), 0, flip);
				void caretEl.offsetWidth;
				caretEl.style.transition = "opacity 0.15s ease-out";
				caretEl.style.opacity = "1";
				await wait(CARET_JUMP_MS);
			}
			flashChar(groupChars[0]);

			// Sweep across the remaining characters like an OCR reading pass.
			for (let j = 1; j < groupChars.length; j++) {
				placeCaret(caretEl, labelEl, rectOf(groupChars[j], sceneEl), CHAR_STEP_MS, flip);
				flashChar(groupChars[j]);
				await wait(CHAR_STEP_MS);
			}

			// Land just past the last character once the group has been "read".
			// When flipped, the very last landing spot (after the "z" in Ruiz) gets
			// a small extra nudge right so the flipped label doesn't crowd it.
			const endRect = rectOf(groupChars[groupChars.length - 1], sceneEl, true);
			if (flip) endRect.left += CARET_END_NUDGE_X;
			placeCaret(caretEl, labelEl, endRect, CHAR_STEP_MS, flip);
			await wait(CHAR_STEP_MS);

			caretEl.classList.add("blinking");

			labelEl.textContent = lastWord.dataset.label ?? "";
			labelEl.style.transition = "opacity 0.15s ease-out";
			labelEl.style.opacity = "1";
			await wait(LABEL_IN_MS);

			await wait(DWELL_MS);

			if (g < WORD_GROUPS.length - 1) {
				// Only the caret fades here so it can jump to the next group: this
				// group's label stays put and visible (see the "settled" cleanup below).
				caretEl.classList.remove("blinking");
				caretEl.style.transition = "opacity 0.15s ease-out";
				caretEl.style.opacity = "0";
				await wait(CARET_JUMP_MS);
			}
		}

		await wait(FINAL_EXTRA_MS);

		// The caret's job (marking the current reading position) is done, it fades out
		// normally here. The labels are handled separately: they stay up until "settled".
		caretEl.classList.remove("blinking");
		caretEl.style.transition = "opacity 0.3s ease-out";
		caretEl.style.opacity = "0";
	}

	function startNameStage() {
		if (scene && caret && labelEls.length === WORD_GROUPS.length && words.length > 0 && !prefersReducedMotion) {
			run(scene, caret, labelEls).then(() => {
				window.dispatchEvent(new Event("name-anim-done"));
			});
		} else {
			window.dispatchEvent(new Event("name-anim-done"));
		}
	}

	window.addEventListener("face-anim-done", startNameStage, { once: true });

	// Detection labels (name/surname) stay on screen through the whole intro; they only
	// fade once the "Available for Work" badge has fully finished showing.
	window.addEventListener("portfolio-intro-settled", () => {
		labelEls.forEach((labelEl) => {
			labelEl.style.transition = "opacity 0.3s ease-out";
			labelEl.style.opacity = "0";
		});
	}, { once: true });
});
</script>

<script>
document.addEventListener("astro:page-load", () => {
	const FACE_MOVE_MS = 450;
	const FACE_LABEL_IN_MS = 200;
	const FACE_DWELL_MS = 600;
	const FACE_START_DELAY_MS = 600;
	const FACE_GRID_STOP_DELAY_MS = 300;
	const FACE_BOX_FADE_DELAY_MS = 500;
	const FACE_LABEL_TEXT = "face: 0.98";

	// Percentage-based guesses, as if a detector were scanning before locking on.
	// "size" is used for both width and height so the box always stays a perfect square.
	const FACE_STEPS = [
		{ left: 4, top: 4, size: 38 }, // off-face: top-left corner
		{ left: 58, top: 50, size: 38 }, // off-face: bottom-right corner
		{ left: 19, top: 8, size: 62 }, // final: locked onto the face
	];

	const faceScene = document.querySelector<HTMLElement>(".face-reveal-scene");
	const faceBox = document.querySelector<HTMLElement>("#face-box");
	const faceLabel = document.querySelector<HTMLElement>("#face-label");
	const facePrefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	function faceWait(ms: number) {
		return new Promise<void>((resolve) => setTimeout(resolve, ms));
	}

	const faceCells = Array.from(document.querySelectorAll<HTMLElement>(".face-cell"));
	let faceCellTimers: number[] = [];

	function startFaceGridFlicker() {
		faceCells.forEach((cell) => {
			const tick = () => {
				cell.style.opacity = (0.08 + Math.random() * 0.5).toFixed(2);
				faceCellTimers.push(window.setTimeout(tick, 300 + Math.random() * 500));
			};
			tick();
		});
	}

	function stopFaceGridFlicker() {
		faceCellTimers.forEach((id) => clearTimeout(id));
		faceCellTimers = [];
		faceCells.forEach((cell) => {
			cell.style.opacity = "0";
		});
	}

	function pxRect(sceneEl: HTMLElement, step: (typeof FACE_STEPS)[number]) {
		const w = sceneEl.clientWidth;
		const h = sceneEl.clientHeight;
		const base = Math.min(w, h);
		const size = (step.size / 100) * base;
		return {
			left: (step.left / 100) * w,
			top: (step.top / 100) * h,
			width: size,
			height: size,
		};
	}

	function placeFaceBox(rect: ReturnType<typeof pxRect>, withTransition: boolean) {
		if (!faceBox || !faceLabel) return;
		const transition = withTransition
			? `left ${FACE_MOVE_MS}ms cubic-bezier(0.22, 1, 0.36, 1), top ${FACE_MOVE_MS}ms cubic-bezier(0.22, 1, 0.36, 1), width ${FACE_MOVE_MS}ms cubic-bezier(0.22, 1, 0.36, 1), height ${FACE_MOVE_MS}ms cubic-bezier(0.22, 1, 0.36, 1)`
			: "none";

		faceBox.style.transition = transition;
		faceBox.style.left = `${rect.left}px`;
		faceBox.style.top = `${rect.top}px`;
		faceBox.style.width = `${rect.width}px`;
		faceBox.style.height = `${rect.height}px`;

		faceLabel.style.transition = transition;
		faceLabel.style.left = `${rect.left}px`;
		faceLabel.style.top = `${rect.top}px`;
	}

	async function runFace(sceneEl: HTMLElement, boxEl: HTMLElement, labelEl: HTMLElement) {
		await faceWait(FACE_START_DELAY_MS);

		placeFaceBox(pxRect(sceneEl, FACE_STEPS[0]), false);
		void boxEl.offsetWidth;

		boxEl.style.transition = "opacity 0.2s ease-out";
		boxEl.style.opacity = "1";
		startFaceGridFlicker();
		await faceWait(FACE_DWELL_MS);

		for (let i = 1; i < FACE_STEPS.length; i++) {
			placeFaceBox(pxRect(sceneEl, FACE_STEPS[i]), true);
			await faceWait(FACE_MOVE_MS);
			await faceWait(FACE_DWELL_MS);
		}

		labelEl.textContent = FACE_LABEL_TEXT;
		labelEl.style.transition = "opacity 0.15s ease-out";
		labelEl.style.opacity = "1";
		await faceWait(FACE_LABEL_IN_MS);

		// Hand off to the name animation as soon as the face label lands, instead of
		// waiting for the rest of this sequence too.
		window.dispatchEvent(new Event("face-anim-done"));

		// Detection is "confirmed" once the label shows, so the scanning grid flicker
		// stops shortly after.
		await faceWait(FACE_GRID_STOP_DELAY_MS);
		stopFaceGridFlicker();

		// The bounding box's job is done once detection is confirmed, it fades out
		// normally here. Only the label sticks around (see "settled" listener below).
		await faceWait(FACE_BOX_FADE_DELAY_MS - FACE_GRID_STOP_DELAY_MS);
		boxEl.style.transition = "opacity 0.3s ease-out";
		boxEl.style.opacity = "0";
	}

	if (faceScene && faceBox && faceLabel && !facePrefersReducedMotion) {
		runFace(faceScene, faceBox, faceLabel);
	} else {
		window.dispatchEvent(new Event("face-anim-done"));
	}

	// The "face: 0.98" label stays on screen through the whole intro; it only fades
	// once the "Available for Work" badge has fully finished showing.
	window.addEventListener("portfolio-intro-settled", () => {
		if (!faceLabel) return;
		faceLabel.style.transition = "opacity 0.3s ease-out";
		faceLabel.style.opacity = "0";
	}, { once: true });
});
</script>

<script>
document.addEventListener("astro:page-load", () => {
	const availableBadge = document.querySelector<HTMLElement>("#available-badge");
	const badgePrefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	// Matches .badge-reveal's max-width transition (the longer of its two transitions):
	// how long the pill takes to fully grow in.
	const BADGE_GROW_IN_MS = 450;
	// Extra breathing room after the badge is fully shown before the tags disappear,
	// so it doesn't feel like they vanish the instant it lands.
	const BADGE_SETTLE_EXTRA_MS = 1000;

	function showAvailableBadge() {
		if (!availableBadge) return;
		availableBadge.style.setProperty("--badge-w", `${availableBadge.scrollWidth}px`);
		availableBadge.classList.add("is-shown");
		// Lets the gear (set up in a later script) know it can start its
		// rolling motion instead of sitting still since page load.
		window.dispatchEvent(new Event("available-badge-shown"));
		if (!badgePrefersReducedMotion) {
			// Let the pill grow into view first, then pop the live dot in shortly after.
			window.setTimeout(() => {
				availableBadge.classList.add("badge-emphasize");
			}, 700);
		}

		// Once the badge has fully finished showing, tell the face/name/surname
		// detection labels they can fade out now.
		window.setTimeout(
			() => window.dispatchEvent(new Event("portfolio-intro-settled")),
			badgePrefersReducedMotion ? 0 : BADGE_GROW_IN_MS + BADGE_SETTLE_EXTRA_MS
		);
	}

	if (availableBadge) {
		if (badgePrefersReducedMotion) {
			showAvailableBadge();
		} else {
			window.addEventListener("name-anim-done", showAvailableBadge, { once: true });
		}
	}
});
</script>

<script>
import {
	Scene,
	Group,
	PerspectiveCamera,
	WebGLRenderer,
	AmbientLight,
	DirectionalLight,
	Shape,
	Path,
	ExtrudeGeometry,
	MeshStandardMaterial,
	Mesh,
	Timer,
	SRGBColorSpace,
} from "three";

// The gear's tooth/hole outline, computed by hand (8 teeth, alternating
// outer/inner radius points around a 24x24 box) rather than borrowed from an
// icon set, so it's guaranteed-valid geometry to extrude. Coordinates are
// normalized to roughly [-0.8, 0.8] (divided by 12, the box's half-width) so
// the mesh sits at a convenient scale for the camera below.
const GEAR_POINTS: [number, number][] = [
	[12, 2.5], [14.6, 5.72], [18.72, 5.28], [18.28, 9.4],
	[21.5, 12], [18.28, 14.6], [18.72, 18.72], [14.6, 18.28],
	[12, 21.5], [9.4, 18.28], [5.28, 18.72], [5.72, 14.6],
	[2.5, 12], [5.72, 9.4], [5.28, 5.28], [9.4, 5.72],
];

function buildGearGeometry(): ExtrudeGeometry {
	const shape = new Shape();
	GEAR_POINTS.forEach(([x, y], i) => {
		const px = (x - 12) / 12;
		const py = -(y - 12) / 12; // SVG's y-down to three.js's y-up
		if (i === 0) shape.moveTo(px, py);
		else shape.lineTo(px, py);
	});
	shape.closePath();

	const hole = new Path();
	hole.absarc(0, 0, 3 / 12, 0, Math.PI * 2, false);
	shape.holes.push(hole);

	const geometry = new ExtrudeGeometry(shape, {
		depth: 0.42,
		bevelEnabled: true,
		bevelThickness: 0.06,
		bevelSize: 0.06,
		bevelSegments: 2,
	});
	geometry.center();
	return geometry;
}

document.addEventListener("astro:page-load", () => {
	const canvas = document.querySelector<HTMLCanvasElement>("#gear-canvas");
	const tag = document.querySelector<HTMLElement>(".freelance-tag");
	if (!canvas || !tag) return;

	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const SIZE = 32;

	let renderer: WebGLRenderer;
	try {
		renderer = new WebGLRenderer({ canvas, alpha: true, antialias: true });
	} catch {
		// No WebGL (old browser, disabled, software-blocked GPU, etc.): fall
		// back to the flat icon rather than leaving an empty canvas.
		tag.classList.add("gear-fallback-active");
		return;
	}

	renderer.outputColorSpace = SRGBColorSpace;
	renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
	renderer.setSize(SIZE, SIZE, false);

	const scene = new Scene();
	const camera = new PerspectiveCamera(32, 1, 0.1, 10);
	camera.position.set(0, 0, 3.4);
	camera.lookAt(0, 0, 0);

	scene.add(new AmbientLight(0xffffff, 0.6));
	const keyLight = new DirectionalLight(0xffffff, 1.5);
	keyLight.position.set(3, 4, 5);
	scene.add(keyLight);
	const rimLight = new DirectionalLight(0xff4d75, 0.6);
	rimLight.position.set(-4, -2, -3);
	scene.add(rimLight);

	const geometry = buildGearGeometry();
	const material = new MeshStandardMaterial({
		color: 0xff375f,
		metalness: 0.55,
		roughness: 0.35,
		emissive: 0x4d0016,
		emissiveIntensity: 0.4,
	});
	const mesh = new Mesh(geometry, material);

	// The pivot holds a fixed isometric-ish tilt so we see both the gear's
	// face and its extruded depth at once. The mesh spins inside that tilted
	// frame on its own local Z axis, the axis running through its hub, the
	// way an actual gear turns on a shaft, rather than tumbling end over end.
	const pivot = new Group();
	pivot.rotation.set(-0.55, 0.5, 0);
	pivot.add(mesh);
	scene.add(pivot);
	renderer.render(scene, camera); // one resting frame, visible before the badge (and thus the spin) starts

	function dispose() {
		cancelAnimationFrame(raf);
		document.removeEventListener("visibilitychange", onVisibilityChange);
		window.removeEventListener("astro:before-swap", dispose);
		timer.dispose();
		renderer.dispose();
		geometry.dispose();
		material.dispose();
	}

	if (prefersReducedMotion) {
		mesh.rotation.z = 0.3;
		renderer.render(scene, camera);
		window.addEventListener("astro:before-swap", dispose, { once: true });
		return;
	}

	const SPIN_SPEED = 1.4;

	// Timer (not the deprecated Clock) also zeroes/resets its own delta
	// across tab-hidden spans via the Page Visibility API once connected.
	const timer = new Timer();
	timer.connect(document);
	let raf = 0;

	function render(timestamp: number) {
		timer.update(timestamp);
		mesh.rotation.z += timer.getDelta() * SPIN_SPEED;
		renderer.render(scene, camera);
		raf = requestAnimationFrame(render);
	}

	// Also fully stop the render loop while the tab is hidden, beyond what
	// Timer's own visibility handling covers, so nothing spins (or burns
	// battery) somewhere the user can't see it.
	function onVisibilityChange() {
		if (document.hidden) {
			cancelAnimationFrame(raf);
		} else {
			raf = requestAnimationFrame(render);
		}
	}

	function startRolling() {
		document.addEventListener("visibilitychange", onVisibilityChange);
		raf = requestAnimationFrame(render);
	}

	window.addEventListener("astro:before-swap", dispose, { once: true });

	// Hold still until the "Available for Work" badge has been shown, so the
	// gear doesn't start moving before the reveal sequence gets there.
	const availableBadge = document.querySelector<HTMLElement>("#available-badge");
	if (availableBadge?.classList.contains("is-shown")) {
		startRolling();
	} else {
		window.addEventListener("available-badge-shown", startRolling, { once: true });
	}
});
</script>

<script>
// Cursor-driven parallax tilt on the hero photo (see src/lib/tilt.ts): the
// "detection box" overlay has no transform of its own (the intro sequence
// only ever animates its left/top/width/height), so it rides along inside
// the photo's tilted 3D space for free, reading as a tracked box on a
// tilting surface rather than a flat sticker.
import { initTiltCards } from "../lib/tilt";

document.addEventListener("astro:page-load", () => {
	function startTilt() {
		initTiltCards(".face-reveal-scene", { maxTilt: 8, perspective: 700 });
	}

	// Same gating as the gear above: don't let the tilt kick in mid-intro,
	// while the face-box is still being choreographed to its locked position.
	const availableBadge = document.querySelector<HTMLElement>("#available-badge");
	if (availableBadge?.classList.contains("is-shown")) {
		startTilt();
	} else {
		window.addEventListener("available-badge-shown", startTilt, { once: true });
	}
});
</script>

