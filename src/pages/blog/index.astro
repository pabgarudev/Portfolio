---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import BlogCard from "../../components/BlogCard.astro";
import Icon3D from "../../components/Icon3D.astro";
import Book from "../../components/icons/Book.astro";
import RssIcon from "../../components/icons/Rss.astro";
import { itemListSchema, breadcrumbSchema } from "../../lib/structuredData";
import { getReadingTime } from "../../lib/readingTime";

const title = "Blog - Pablo García Ruiz";
const description = "My notes on computer vision engineering, research, and the roles I've held along the way.";
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const posts = (await getCollection("blog", ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const structuredData = [
  itemListSchema({
    name: "Blog",
    description,
    url: pageUrl,
    items: posts.map((post) => ({
      name: post.data.title,
      url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
    })),
  }),
  breadcrumbSchema([
    { name: "Home", url: new URL("/", Astro.site).toString() },
    { name: "Blog", url: pageUrl },
  ]),
];
---

<Layout title={title} description={description} structuredData={structuredData}>
  <main id="main-content" class="px-5 sm:px-8">
    <SectionContainer class="pt-28 sm:pt-36 lg:pt-44 pb-8">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm text-neutral-950/70 dark:text-white/50 transition hover:text-neutral-950 hover:dark:text-white"
      >
        <svg
          class="size-4"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12l14 0" />
          <path d="M5 12l6 6" />
          <path d="M5 12l6 -6" />
        </svg>
        Back home
      </a>

      <!-- The feed link sits beside the heading rather than inside it: an <a>
           nested in the <h1> would fold "Subscribe via RSS" into the heading's
           own accessible name. -->
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 pt-4 pb-4">
        <h1 class="text-neutral-950 dark:text-white text-3xl md:text-4xl lg:text-5xl font-bold leading-tight flex items-center gap-3">
          <Icon3D id="icon3d-blog-page" rotation={[-0.52, 0.22, -0.2]} class="size-16 sm:size-20" popIn>
            <Book class="icon3d-fallback size-16 sm:size-20" />
          </Icon3D>
          Blog
        </h1>

        <a
          href="/rss.xml"
          class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-neutral-950/10 dark:border-white/10 bg-neutral-950/5 dark:bg-white/5 px-3 py-1.5 text-xs font-mono font-medium text-neutral-950/70 dark:text-white/60 transition hover:border-[#7877c6]/45 hover:dark:border-[#7877c6]/30 hover:bg-neutral-950/10 hover:dark:bg-white/10 hover:text-neutral-950 hover:dark:text-white"
        >
          <RssIcon class="size-3.5" />
          RSS
        </a>
      </div>
      <p class="text-base lg:text-lg text-neutral-950/70 dark:text-white/60 max-w-[640px] leading-relaxed">
        {description}
      </p>
    </SectionContainer>

    <section class="scroll-mt-24 w-full max-w-[800px] mx-auto pb-24">
      {
        posts.length > 0 ? (
          <div class="flex flex-col gap-8">
            {posts.map((post) => (
              <BlogCard
                slug={post.id}
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                tags={post.data.tags}
                readingMinutes={getReadingTime(post.body ?? "")}
              />
            ))}
          </div>
        ) : (
          <p class="text-neutral-950/70 dark:text-white/50 text-center">No posts yet, check back soon.</p>
        )
      }
    </section>
  </main>
</Layout>
