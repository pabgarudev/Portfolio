<span
    class="badge-root relative isolate inline-flex items-center gap-2 text-[var(--accent-green)] text-xs font-mono font-medium me-2 px-3 py-1"
>
    <span class="badge-bg absolute inset-0 -z-10 rounded bg-[#00e08f]/30 dark:bg-[#00e08f]/15"></span>
    <span class="badge-dot relative flex size-3.5 shrink-0 -ml-5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#33e6a5] opacity-75"></span>
        <span class="badge-dot-burst absolute inline-flex h-full w-full rounded-full bg-[#33e6a5]"></span>
        <span class="badge-dot-core relative inline-flex size-3.5 rounded-full bg-[#33e6a5]"></span>
    </span>
    <span class="ml-2"><slot /></span>
</span>

<style>
    /* Punch a soft round hole through the badge's green wash right where the
       live dot sits, so the page's background animation shows through the
       cutout (and behind the dot) instead of a flat white/black patch. The
       hole is centred on the dot; --badge-hole-x is its offset from the
       badge's left edge (the dot is pulled left of it by .badge-dot's -ml-5). */
    .badge-bg {
        --badge-hole-x: -2px;
        -webkit-mask: radial-gradient(
            circle at var(--badge-hole-x) 50%,
            transparent 0,
            transparent 12px,
            #000 30px
        );
        mask: radial-gradient(
            circle at var(--badge-hole-x) 50%,
            transparent 0,
            transparent 12px,
            #000 30px
        );
    }

    .badge-dot {
        opacity: 0;
        transform: scale(0.3);
    }

    .badge-dot-burst {
        opacity: 0;
    }

    .badge-dot-core {
        box-shadow: 0 0 6px 1.5px rgba(51, 230, 165, 0.85);
    }

    :global(.badge-emphasize) .badge-dot {
        animation: badge-emphasis-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    :global(.badge-emphasize) .badge-dot-burst {
        animation: badge-emphasis-burst 0.7s ease-out;
    }

    @keyframes badge-emphasis-pop {
        0% { opacity: 0; transform: scale(0.3); }
        55% { opacity: 1; transform: scale(1.5); }
        100% { opacity: 1; transform: scale(1); }
    }

    @keyframes badge-emphasis-burst {
        0% { opacity: 0.8; transform: scale(1); }
        100% { opacity: 0; transform: scale(2.8); }
    }

    @media (prefers-reduced-motion: reduce) {
        .badge-dot {
            opacity: 1;
            transform: none;
        }
    }
</style>
