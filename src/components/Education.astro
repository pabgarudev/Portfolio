---
import EducationItem from "./EducationItem.astro";
import LanguageIcon from "./icons/Language.astro";
import { LOGOS } from "../data/logos";

const UCO_LOGO = LOGOS.uco;

const MAIN_EDUCATION = [
  {
    title: "Ph.D. in Advanced Computing",
    institution: "University of Córdoba, Spain",
    date: "2022 - 2025",
    honor: "Cum Laude",
    link: "/projects#thesis",
    logo: UCO_LOGO,
  },
  {
    title: "Master in Computational Intelligence & IoT",
    institution: "University of Córdoba, Spain",
    date: "2021 - 2022",
    logo: UCO_LOGO,
  },
  {
    title: "Software Engineering",
    institution: "University of Córdoba, Spain",
    date: "2017 - 2021",
    logo: UCO_LOGO,
  },
];

const OTHER_EDUCATION = [
  {
    title: "Summer School in Computer Vision",
    institution: "British Machine Vision Association, Norwich, UK",
    date: "2023",
  },
];

const LANGUAGES = [
  {
    name: "Spanish",
    flag: "🇪🇸",
    level: "Native",
    certification: null,
  },
  {
    name: "English",
    flag: "🇬🇧",
    level: "C1",
    certification: "Cambridge",
  },
];
---

<div class="flex flex-col gap-2">
  {MAIN_EDUCATION.map((item) => <EducationItem {...item} />)}
</div>

<div class="mt-6">
  <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-white/50">
    Others
  </h3>

  <div class="flex flex-col gap-2">
    {OTHER_EDUCATION.map((item) => <EducationItem {...item} />)}
  </div>
</div>

<div class="mt-6">
  <h3 class="mb-3 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-white/50">
    <LanguageIcon class="size-3.5" />
    Languages
  </h3>

  <div class="flex flex-wrap gap-2.5">
    {
      LANGUAGES.map((lang) => (
        <span class="lang-pill inline-flex items-center gap-2.5 rounded-full border border-[#7877c6]/20 bg-[#7877c6]/[0.08] px-4 py-2 font-mono text-sm text-white/70 backdrop-blur-sm">
          <span class="text-lg leading-none">{lang.flag}</span>
          <span class="flex items-baseline gap-1.5 whitespace-nowrap">
            <strong class="font-bold text-white">{lang.name}</strong>
            <span class="text-xs" style="color: color-mix(in srgb, white 20%, #7877c6 80%);">
              {lang.level}
              {lang.certification && <span class="text-white/40"> · {lang.certification}</span>}
            </span>
          </span>
        </span>
      ))
    }
  </div>
</div>
