---
// Inlines a generated SVG diagram from src/assets/diagrams/.
//
// Inlined rather than referenced with <img src>: an SVG behind an <img> is an
// isolated document, so the page's data-theme attribute cannot reach inside
// it. The diagram would silently fall back to following the reader's OS
// setting, giving someone on a dark OS a dark diagram on a white page. Inline,
// the CSS variables the SVG declares resolve against our toggle instead.
//
// The diagrams are generated by the (gitignored) .diagrams workspace; see
// .diagrams/README.md. Each one carries its own scoped <style>, <title> and
// <desc>, so nothing here needs to know anything about its content.
interface Props {
  /** Filename without extension, e.g. "p3p-ambiguity". */
  name: string;
  caption?: string;
  /**
   * Minimum rendered width before horizontal scrolling kicks in. These are
   * dense technical figures: letting one shrink to a 400px phone screen would
   * render its labels at about 5px. Scrolling keeps them legible instead.
   */
  minWidth?: number;
  class?: string;
}

const {
  name,
  caption,
  minWidth = 620,
  class: className = "mt-6 max-w-[680px]",
} = Astro.props;

const svgs = import.meta.glob("../assets/diagrams/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const key = `../assets/diagrams/${name}.svg`;
const svg = svgs[key] as string | undefined;

if (!svg) {
  const available = Object.keys(svgs)
    .map((p) => p.replace("../assets/diagrams/", "").replace(".svg", ""))
    .join(", ");
  throw new Error(
    `<Diagram name="${name}" /> not found. Available: ${available || "none"}`
  );
}
---

<figure
  class={`overflow-hidden rounded-2xl border border-neutral-950/10 dark:border-white/10 bg-neutral-950/[0.03] dark:bg-white/[0.03] ${className}`}
>
  <div class="overflow-x-auto">
    <div class="p-3 sm:p-4" style={`min-width:${minWidth}px`} set:html={svg} />
  </div>
  {
    caption && (
      <figcaption class="border-t border-neutral-950/10 dark:border-white/10 px-4 py-2.5 text-xs text-neutral-950/70 dark:text-white/50">
        {caption}
      </figcaption>
    )
  }
</figure>
