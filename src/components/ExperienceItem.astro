---
import "../styles/global.css";
import ArrowRight from "./icons/ArrowRight.astro";
import Button from "./Button.astro";
const { date, role, org, description, link, isLast, logo, logoClass = "h-4.5", stats = [] } = Astro.props;

const hasFollowing = stats.length > 0 || Boolean(link);
---

<li class={`${isLast ? "" : "mb-10"} ms-4`}>
  <div class="absolute w-3 h-3 bg-white rounded-full mt-1.5 -start-1.5 border-2 border-neutral-950"></div>

  <time class="font-mono text-sm font-medium leading-none text-neutral-200 tracking-tight">
  <span class="text-[#7877c6]/50 mr-1 font-black">/* </span>
  <span style="color: color-mix(in srgb, white 20%, #7877c6 80%);">{date}</span>
  <span class="text-[#7877c6]/50 ml-1 font-black"> */</span>
</time>

  <div class="mt-3 flex flex-wrap items-center gap-2 text-sm font-semibold uppercase tracking-wider text-white/60">
    {org}
    {logo && <img src={logo} alt="" class={`${logoClass} w-auto shrink-0 opacity-80`} />}
  </div>

  <h3 class="text-2xl font-extrabold text-white mt-2 mb-1.5 tracking-wide">
    {role}
  </h3>

  <p class={`${hasFollowing ? "mb-4" : ""} text-base font-normal text-pretty`} style="color: color-mix(in srgb, white 80%, #7877c6 20%);">
    {description}
  </p>

  {
    stats.length > 0 && (
      <div class={`exp-stats flex flex-wrap gap-2 ${link ? "mb-4" : ""}`}>
        {stats.map((stat: { icon: any; value?: string; label: string }, i: number) => (
          <span
            class="stat-pill inline-flex items-center gap-1.5 rounded-full border border-[#7877c6]/20 bg-[#7877c6]/[0.08] px-3 py-1 text-xs font-mono text-white/70 backdrop-blur-sm"
            style={`--stat-i: ${i};`}
          >
            <stat.icon class="size-3.5 shrink-0 text-[#7877c6]" />
            {stat.value && <strong class="font-bold text-white">{stat.value}</strong>}
            {stat.label}
          </span>
        ))}
      </div>
    )
  }

  {
    link && (
      <Button href={link}>
        Learn more
        <ArrowRight class="size-4" />
      </Button>
    )
  }
</li>

<style>
  .stat-pill {
    opacity: 1;
    transform: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .stat-pill:hover {
    transform: scale(1.06);
    border-color: rgba(120, 119, 198, 0.4);
    background-color: rgba(120, 119, 198, 0.14);
  }

  .exp-stats--animated .stat-pill {
    opacity: 0;
    transform: translateY(8px) scale(0.92);
  }

  .exp-stats--animated.in-view .stat-pill {
    animation: stat-pill-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(var(--stat-i) * 120ms);
  }

  @keyframes stat-pill-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-stats--animated .stat-pill {
      opacity: 1;
      transform: none;
    }

    .stat-pill,
    .stat-pill:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
document.addEventListener("astro:page-load", () => {
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const groups = document.querySelectorAll<HTMLElement>(".exp-stats");

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    groups.forEach((group) => {
      group.classList.add("exp-stats--animated");
      observer.observe(group);
    });
  }
});
</script>