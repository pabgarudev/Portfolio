---
// Renders a slot for a section-heading icon that gets turned into a solid,
// gently floating 3D mesh at runtime (see src/lib/icon3dRuntime.ts and
// src/lib/icon3d.ts). The flat icon passed as the default slot is both the
// source geometry (its own stroke paths get extruded) and the fallback
// shown if WebGL init fails or JS never runs — it must carry the
// "icon3d-fallback" class itself for that toggle to work.
interface Props {
	id: string;
	// Fixed isometric-ish tilt the icon rests at; varied per instance so a
	// page with several of these doesn't look like stamped copies.
	rotation?: [number, number, number];
	depth?: number;
	class?: string;
	// When true, the slot starts collapsed (zero width, icon invisible)
	// instead of holding open a blank icon-shaped gap while three.js loads
	// and WebGL spins up. icon3dRuntime.ts adds .icon3d-ready once the mesh
	// has its first frame, which grows the slot open and fades the icon in.
	// Opt-in: most usages sit inline with a heading, where a fixed reserved
	// slot is fine and there's no surrounding text to visibly shove over.
	deferReveal?: boolean;
}

const {
	id,
	rotation = [-0.4, 0.35, 0.12],
	depth = 4.2,
	class: className = "size-11",
	deferReveal = false,
} = Astro.props;
---

<span
	id={id}
	class:list={["icon3d-slot relative inline-block", className, { "icon3d-slot--defer": deferReveal }]}
	data-rotation={JSON.stringify(rotation)}
	data-depth={depth}
	aria-hidden="true"
>
	<canvas class="icon3d-canvas"></canvas>
	<slot />
</span>

<style>
	.icon3d-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.icon3d-slot :global(.icon3d-fallback) {
		display: none;
	}

	.icon3d-slot.icon3d-fallback-active .icon3d-canvas {
		display: none;
	}

	.icon3d-slot.icon3d-fallback-active :global(.icon3d-fallback) {
		display: inline-block;
	}

	/* Height stays whatever the size-* class says (so the runtime script can
	   still read a real, non-zero size off the slot to set up the renderer);
	   only width and spacing collapse, since those are what create a visible
	   blank gap in surrounding text. --icon3d-w is set by icon3dRuntime.ts,
	   once, to the slot's own (square) height, right before reveal. */
	.icon3d-slot--defer {
		width: 0 !important;
		margin-right: 0;
		transition: width 0.3s ease-out, margin-right 0.3s ease-out;
	}

	.icon3d-slot--defer .icon3d-canvas,
	.icon3d-slot--defer :global(.icon3d-fallback) {
		opacity: 0;
		transition: opacity 0.25s ease-out 0.3s;
	}

	.icon3d-slot--defer.icon3d-ready {
		width: var(--icon3d-w, 2.75rem) !important;
		margin-right: 0.5rem;
	}

	.icon3d-slot--defer.icon3d-ready .icon3d-canvas,
	.icon3d-slot--defer.icon3d-ready :global(.icon3d-fallback) {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.icon3d-slot--defer {
			width: var(--icon3d-w, 2.75rem) !important;
			margin-right: 0.5rem;
			transition: none;
		}

		.icon3d-slot--defer .icon3d-canvas,
		.icon3d-slot--defer :global(.icon3d-fallback) {
			opacity: 1;
			transition: none;
		}
	}
</style>
