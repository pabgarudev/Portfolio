---
import { Image } from "astro:assets";
import logoImage from "../assets/p_shadow.png";
import asteriskImage from "../assets/asterisc.png";
import Button from "./Button.astro";
import DownloadIcon from "./icons/Download.astro";

const { pathname } = Astro.url;
const isHome = pathname === "/";
const isProjects = pathname.startsWith("/projects");
const isBlog = pathname.startsWith("/blog");
---

    <header class="fixed top-0 left-0 right-0 z-[999] bg-neutral-950/20 backdrop-blur-md border-b border-white/5" transition:persist>
    <div class="flex justify-between items-center py-3 px-5 sm:px-8 w-full max-w-[1120px] mx-auto">
        <a href="/" class="shrink-0">
        <Image
        src={logoImage}
        width={96}
        alt="Pablo García Ruiz logo"
        loading="eager"
        format="webp"
        class="rounded-full w-auto h-12"
        />
        </a>

        <nav class="hidden md:flex gap-x-10">
        <a href="/" data-nav="home" aria-current={isHome ? "page" : undefined}>Home</a>
        <a href="/#experience">Experience</a>
        <a href="/#education">Education</a>
        <a href="/projects/" class="flex items-center gap-1.5" data-nav="projects" aria-current={isProjects ? "page" : undefined}>
          Projects
          <svg
            class="size-3.5"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M17 7l-10 10" />
            <path d="M8 7l9 0l0 9" />
          </svg>
        </a>
        <a href="/blog/" class="flex items-center gap-1.5" data-nav="blog" aria-current={isBlog ? "page" : undefined}>
          Blog
          <svg
            class="size-3.5"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M17 7l-10 10" />
            <path d="M8 7l9 0l0 9" />
          </svg>
        </a>
        <a href="/#about-me">About me</a>
        <a href="/#contact">Contact</a>
        </nav>

        <div class="hidden md:block">
          <Button href="/cv.pdf" download="Pablo-Garcia-Ruiz-CV.pdf">
            CV
            <DownloadIcon class="size-3.5" />
          </Button>
        </div>

        <button
        id="menu-button"
        class="md:hidden text-white text-3xl font-mono font-bold tracking-tight"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        >
        <span id="menu-icon" class="inline-flex items-center font-mono">
  <span id="slash-left" class="relative z-0 translate-x-0.5 bg-transparent transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]">/</span>
  <span
    id="comment-middle"
    class="grid grid-cols-[0fr] overflow-hidden pl-0.5 pr-0 transition-all duration-300 ease-out"
  >
    <span id="comment-middle-inner" class="min-w-0 overflow-hidden whitespace-nowrap inline-flex items-center gap-4 pt-1 opacity-0 transition-opacity duration-200 ease-out">
      <span class="asterisk-slot relative inline-block size-4 -translate-y-1" aria-hidden="true">
        <canvas id="asterisk-canvas-1" class="asterisk-canvas" width="16" height="16"></canvas>
        <Image src={asteriskImage} width={32} alt="" format="webp" class="asterisk-fallback size-4 object-contain" />
      </span>
      <span class="asterisk-slot relative z-20 inline-block size-4 -translate-y-1 mr-2" aria-hidden="true">
        <canvas id="asterisk-canvas-2" class="asterisk-canvas" width="16" height="16"></canvas>
        <Image src={asteriskImage} width={32} alt="" format="webp" class="asterisk-fallback size-4 object-contain" />
      </span>
    </span>
  </span>
  <span class="relative z-10 bg-transparent">/</span>
</span>
        </button>
    </div>
    </header>

<noscript>
  <style>
    .asterisk-canvas { display: none !important; }
    .asterisk-fallback { display: inline-block !important; }
  </style>
</noscript>

<style>
  /* The two asterisks are WebGL-rendered meshes (real extruded bars, lit and
     tilted by an actual camera), not the flat pre-rendered PNG this used to
     be. .asterisk-fallback (the original image) only shows if WebGL init
     fails or JS never runs, see the script below and the <noscript> above. */
  .asterisk-fallback {
    display: none;
  }

  .asterisk-fallback-active .asterisk-canvas {
    display: none;
  }

  .asterisk-fallback-active .asterisk-fallback {
    display: inline-block;
  }
</style>

<script>
import {
	Scene,
	Group,
	PerspectiveCamera,
	WebGLRenderer,
	AmbientLight,
	DirectionalLight,
	BoxGeometry,
	MeshStandardMaterial,
	Mesh,
	SRGBColorSpace,
} from "three";

document.addEventListener("astro:page-load", () => {
	// Header is `transition:persist`, so this listener fires again on every
	// navigation: guard so the WebGL asterisks are only ever built once (they
	// stay alive in the persisted DOM for the rest of the tab's lifetime,
	// unlike the gear on the homepage, so there's no dispose-on-navigate
	// needed here).
	const header = document.querySelector<HTMLElement>("header");
	if (!header || header.dataset.asterisksBound === "true") return;
	header.dataset.asterisksBound = "true";

	const SIZE = 16;

	// One shared bar geometry/material, reused across all 6 blades (3 per
	// asterisk x 2 asterisks): they're visually identical, so there's no
	// reason to allocate six separate copies.
	const geometry = new BoxGeometry(0.32, 2, 0.34);
	const material = new MeshStandardMaterial({
		color: 0xff375f,
		metalness: 0.5,
		roughness: 0.4,
		emissive: 0x4d0016,
		emissiveIntensity: 0.35,
	});

	// Three bars crossing through a shared center, each 60deg apart, reads
	// as a six-point asterisk exactly like the original PNG (which was
	// itself a pre-rendered 3D asterisk, just flattened to an image).
	function buildAsteriskGroup(): Group {
		const group = new Group();
		for (let i = 0; i < 3; i++) {
			const bar = new Mesh(geometry, material);
			bar.rotation.z = (i * Math.PI) / 3;
			group.add(bar);
		}
		return group;
	}

	function initAsterisk(canvasId: string, extraSpin: number, xOffset: number, yaw: number) {
		const canvas = document.querySelector<HTMLCanvasElement>(`#${canvasId}`);
		const slot = canvas?.closest<HTMLElement>(".asterisk-slot");
		if (!canvas || !slot) return;

		let renderer: WebGLRenderer;
		try {
			renderer = new WebGLRenderer({ canvas, alpha: true, antialias: true });
		} catch {
			// No WebGL: fall back to the original flat image rather than an
			// empty canvas.
			slot.classList.add("asterisk-fallback-active");
			return;
		}

		renderer.outputColorSpace = SRGBColorSpace;
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
		renderer.setSize(SIZE, SIZE, false);

		const scene = new Scene();
		const camera = new PerspectiveCamera(28, 1, 0.1, 10);
		camera.position.set(0, 0, 7.1);
		camera.lookAt(0, 0, 0);

		scene.add(new AmbientLight(0xffffff, 0.6));
		const keyLight = new DirectionalLight(0xffffff, 1.6);
		keyLight.position.set(3, 4, 5);
		scene.add(keyLight);
		const rimLight = new DirectionalLight(0xff4d75, 0.5);
		rimLight.position.set(-3, -2, -3);
		scene.add(rimLight);

		// Fixed isometric-ish tilt, matching the reference image: this is a
		// static logo mark, not something that needs to spin like the pill's
		// gear, so a single rendered frame is all it needs. extraSpin gives
		// each of the two asterisks its own look instead of being identical
		// copies stacked on top of each other.
		const pivot = new Group();
		pivot.rotation.set(-0.5, yaw, extraSpin);
		pivot.position.x = xOffset;
		pivot.position.y = 0.52;
		pivot.add(buildAsteriskGroup());
		scene.add(pivot);

		renderer.render(scene, camera);
	}

	initAsterisk("asterisk-canvas-1", 0, -0.32, 0.35);
	initAsterisk("asterisk-canvas-2", Math.PI / 7, -0.28, 0.35);
});
</script>