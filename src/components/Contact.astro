---
import LinkedInIcon from "./icons/LinkedIn.astro";
---

<div class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] backdrop-blur-sm shadow-2xl">
  <div class="grain-mask-soft pointer-events-none absolute -left-24 -top-24 h-72 w-72 opacity-10 blur-[90px]" style="background:#7877c6; border-radius:58% 42% 63% 37% / 41% 55% 45% 59%; transform:rotate(-8deg)"></div>
  <div class="grain-mask pointer-events-none absolute -left-16 -top-16 h-56 w-56 opacity-20 blur-[70px]" style="background:#7877c6; border-radius:34% 66% 71% 29% / 62% 38% 60% 40%; transform:rotate(12deg)"></div>
  <div class="grain-mask-soft pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 opacity-10 blur-[90px]" style="background:#00e08f; border-radius:66% 34% 40% 60% / 55% 45% 60% 40%; transform:rotate(20deg)"></div>
  <div class="grain-mask pointer-events-none absolute -bottom-16 -right-16 h-56 w-56 opacity-20 blur-[70px]" style="background:#00e08f; border-radius:38% 62% 55% 45% / 36% 64% 42% 58%; transform:rotate(-15deg)"></div>

  <div class="relative grid gap-10 p-8 sm:p-10 lg:grid-cols-[1fr_260px]">
    <div>
      <h3 class="text-2xl sm:text-xl font-bold text-white">
        Let's build it
      </h3>

      <p class="mt-4 max-w-[560px] text-white/60 leading-relaxed">
        Computer vision work, web dev, branding, or something else entirely, send me a quick message and I’ll get back to you as soon as possible.
      </p>

      <form id="contact-form" method="POST" action="/api/contact" class="mt-8 flex flex-col gap-4">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="contact-name" class="text-xs font-medium text-white/50">
              Name
            </label>
            <input
              id="contact-name"
              type="text"
              name="name"
              required
              placeholder="Your name"
              class="rounded-2xl border border-white/10 bg-white/[0.04] px-5 py-3 text-white placeholder:text-white/35 outline-none transition-colors focus:border-[#7877c6]/50 focus-visible:ring-2 focus-visible:ring-[#7877c6]/60 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="contact-email" class="text-xs font-medium text-white/50">
              Email
            </label>
            <input
              id="contact-email"
              type="email"
              name="email"
              required
              placeholder="you@email.com"
              class="rounded-2xl border border-white/10 bg-white/[0.04] px-5 py-3 text-white placeholder:text-white/35 outline-none transition-colors focus:border-[#7877c6]/50 focus-visible:ring-2 focus-visible:ring-[#7877c6]/60 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
            />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <span class="text-xs font-medium text-white/50">
            What are you looking for? <span class="text-white/30">(optional)</span>
          </span>
          <div class="flex flex-wrap gap-2">
            <label class="engagement-chip group relative cursor-pointer">
              <input type="radio" name="engagementType" value="full-time" class="peer sr-only" />
              <span class="flex select-none items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.04] py-2.5 pr-4 pl-4 text-sm text-white/60 transition-all duration-200 group-has-checked:gap-1.5 group-has-checked:pl-3 group-hover:border-white/20 group-hover:bg-white/[0.07] group-hover:text-white/80 group-active:scale-[0.97] group-has-checked:border-transparent group-has-checked:bg-[#7877c6] group-has-checked:text-white group-has-checked:shadow-[0_6px_18px_-6px_rgba(120,119,198,0.7)] peer-focus-visible:ring-2 peer-focus-visible:ring-[#7877c6]/60 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-neutral-950">
                <svg
                  class="size-0 shrink-0 scale-0 opacity-0 transition-all duration-200 group-has-checked:size-3.5 group-has-checked:scale-100 group-has-checked:opacity-100"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12l5 5l10 -10" />
                </svg>
                Full-time role
              </span>
            </label>
            <label class="engagement-chip group relative cursor-pointer">
              <input type="radio" name="engagementType" value="freelance" class="peer sr-only" />
              <span class="flex select-none items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.04] py-2.5 pr-4 pl-4 text-sm text-white/60 transition-all duration-200 group-has-checked:gap-1.5 group-has-checked:pl-3 group-hover:border-white/20 group-hover:bg-white/[0.07] group-hover:text-white/80 group-active:scale-[0.97] group-has-checked:border-transparent group-has-checked:bg-[#7877c6] group-has-checked:text-white group-has-checked:shadow-[0_6px_18px_-6px_rgba(120,119,198,0.7)] peer-focus-visible:ring-2 peer-focus-visible:ring-[#7877c6]/60 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-neutral-950">
                <svg
                  class="size-0 shrink-0 scale-0 opacity-0 transition-all duration-200 group-has-checked:size-3.5 group-has-checked:scale-100 group-has-checked:opacity-100"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12l5 5l10 -10" />
                </svg>
                Freelance
              </span>
            </label>
            <label class="engagement-chip group relative cursor-pointer">
              <input type="radio" name="engagementType" value="collab" class="peer sr-only" />
              <span class="flex select-none items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.04] py-2.5 pr-4 pl-4 text-sm text-white/60 transition-all duration-200 group-has-checked:gap-1.5 group-has-checked:pl-3 group-hover:border-white/20 group-hover:bg-white/[0.07] group-hover:text-white/80 group-active:scale-[0.97] group-has-checked:border-transparent group-has-checked:bg-[#7877c6] group-has-checked:text-white group-has-checked:shadow-[0_6px_18px_-6px_rgba(120,119,198,0.7)] peer-focus-visible:ring-2 peer-focus-visible:ring-[#7877c6]/60 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-neutral-950">
                <svg
                  class="size-0 shrink-0 scale-0 opacity-0 transition-all duration-200 group-has-checked:size-3.5 group-has-checked:scale-100 group-has-checked:opacity-100"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12l5 5l10 -10" />
                </svg>
                Collaboration
              </span>
            </label>
            <label class="engagement-chip group relative cursor-pointer">
              <input type="radio" name="engagementType" value="hi" class="peer sr-only" />
              <span class="flex select-none items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.04] py-2.5 pr-4 pl-4 text-sm text-white/60 transition-all duration-200 group-has-checked:gap-1.5 group-has-checked:pl-3 group-hover:border-white/20 group-hover:bg-white/[0.07] group-hover:text-white/80 group-active:scale-[0.97] group-has-checked:border-transparent group-has-checked:bg-[#7877c6] group-has-checked:text-white group-has-checked:shadow-[0_6px_18px_-6px_rgba(120,119,198,0.7)] peer-focus-visible:ring-2 peer-focus-visible:ring-[#7877c6]/60 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-neutral-950">
                <svg
                  class="size-0 shrink-0 scale-0 opacity-0 transition-all duration-200 group-has-checked:size-3.5 group-has-checked:scale-100 group-has-checked:opacity-100"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12l5 5l10 -10" />
                </svg>
                Just saying hi
              </span>
            </label>
            <label class="engagement-chip group relative cursor-pointer">
              <input type="radio" name="engagementType" value="other" class="peer sr-only" />
              <span class="flex select-none items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.04] py-2.5 pr-4 pl-4 text-sm text-white/60 transition-all duration-200 group-has-checked:gap-1.5 group-has-checked:pl-3 group-hover:border-white/20 group-hover:bg-white/[0.07] group-hover:text-white/80 group-active:scale-[0.97] group-has-checked:border-transparent group-has-checked:bg-[#7877c6] group-has-checked:text-white group-has-checked:shadow-[0_6px_18px_-6px_rgba(120,119,198,0.7)] peer-focus-visible:ring-2 peer-focus-visible:ring-[#7877c6]/60 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-neutral-950">
                <svg
                  class="size-0 shrink-0 scale-0 opacity-0 transition-all duration-200 group-has-checked:size-3.5 group-has-checked:scale-100 group-has-checked:opacity-100"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12l5 5l10 -10" />
                </svg>
                Something else
              </span>
            </label>
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="contact-message" class="text-xs font-medium text-white/50">
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            placeholder="Tell me a bit about what you have in mind..."
            class="resize-none rounded-2xl border border-white/10 bg-white/[0.04] px-5 py-3 text-white placeholder:text-white/35 outline-none transition-colors focus:border-[#7877c6]/50 focus-visible:ring-2 focus-visible:ring-[#7877c6]/60 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
          ></textarea>
        </div>

        <div class="hidden" aria-hidden="true">
          <label for="contact-company">Company</label>
          <input id="contact-company" type="text" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <p id="contact-status" class="translate-y-1 text-sm opacity-0 transition-all duration-300" role="status"></p>

        <div class="mt-2 flex flex-wrap items-center justify-center gap-4">
          <button
            id="contact-submit"
            type="submit"
            data-state="idle"
            class="relative inline-flex w-full max-w-xs shrink-0 items-center justify-center gap-2 overflow-visible rounded-full bg-white px-6 py-3.5 font-medium text-neutral-950 transition-[background-color,transform] duration-300 hover:bg-white/80 disabled:cursor-not-allowed disabled:opacity-60 data-[state=success]:bg-[#00e08f] data-[state=success]:hover:bg-[#00e08f]"
          >
            <span id="contact-confetti" class="pointer-events-none absolute inset-0"></span>
            <span id="contact-submit-label">Send message</span>
            <span class="relative inline-flex size-4 shrink-0">
              <svg
                id="contact-icon-arrow"
                class="absolute inset-0 size-4 transition-all duration-300"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M10 14l11 -11" />
                <path d="M21 3l-6.5 18a0.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a0.55 .55 0 0 1 0 -1l18 -6.5" />
              </svg>
              <svg
                id="contact-icon-check"
                class="absolute inset-0 size-4 scale-50 opacity-0 transition-all duration-300"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12l5 5l10 -10" />
              </svg>
            </span>
          </button>
        </div>
      </form>
    </div>

    <div class="flex flex-col gap-6 lg:border-l lg:border-white/10 lg:pl-10">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-white/50">
          Quick contact
        </p>

        <div class="mt-3 flex flex-col gap-2">
          <a
            href="mailto:pabgarudev@gmail.com"
            class="flex items-center gap-2.5 rounded-xl border border-white/10 bg-white/[0.02] px-4 py-2.5 text-sm text-white/70 transition hover:border-[#7877c6]/30 hover:bg-white/[0.05] hover:text-white"
          >
            <svg
              class="size-4 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" />
              <path d="M3 7l9 6l9 -6" />
            </svg>
            <span class="truncate">pabgarudev@gmail.com</span>
          </a>

          <a
            href="https://www.linkedin.com/in/pablo-garc%C3%ADa-ruiz-9640332a3/"
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2.5 rounded-xl border border-white/10 bg-white/[0.02] px-4 py-2.5 text-sm text-white/70 transition hover:border-[#7877c6]/30 hover:bg-white/[0.05] hover:text-white"
          >
            <LinkedInIcon class="size-4 shrink-0" />
            LinkedIn
          </a>
        </div>
      </div>

      <div class="flex items-center gap-2 text-xs text-white/50">
        <span class="relative flex size-2 shrink-0">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span>
        </span>
        I usually respond within a day
      </div>
    </div>
  </div>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const submitButton = document.querySelector<HTMLButtonElement>("#contact-submit");
  const submitLabel = document.querySelector<HTMLSpanElement>("#contact-submit-label");
  const arrowIcon = document.querySelector<SVGSVGElement>("#contact-icon-arrow");
  const checkIcon = document.querySelector<SVGSVGElement>("#contact-icon-check");
  const confetti = document.querySelector<HTMLSpanElement>("#contact-confetti");
  const status = document.querySelector<HTMLParagraphElement>("#contact-status");

  const CONFETTI_COLORS = ["#7877c6", "#00e08f", "#ffffff"];
  let revertTimeout: ReturnType<typeof setTimeout> | undefined;

  function burstConfetti() {
    if (!confetti) return;
    confetti.innerHTML = "";
    const count = 10;
    for (let i = 0; i < count; i++) {
      const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.4;
      const distance = 26 + Math.random() * 18;
      const dot = document.createElement("span");
      dot.className = "confetti-dot";
      dot.style.setProperty("--tx", `${Math.cos(angle) * distance}px`);
      dot.style.setProperty("--ty", `${Math.sin(angle) * distance}px`);
      dot.style.setProperty("--delay", `${Math.random() * 80}ms`);
      dot.style.background = CONFETTI_COLORS[i % CONFETTI_COLORS.length];
      confetti.appendChild(dot);
    }
    confetti.classList.remove("is-active");
    void confetti.offsetWidth;
    confetti.classList.add("is-active");
  }

  function setStatus(text: string, variant: "success" | "error") {
    if (!status) return;
    status.textContent = text;
    status.classList.remove("text-emerald-400", "text-red-400", "opacity-0", "translate-y-1");
    status.classList.add(variant === "success" ? "text-emerald-400" : "text-red-400");
  }

  function setButtonState(state: "idle" | "loading" | "success" | "error") {
    if (!submitButton || !submitLabel || !arrowIcon || !checkIcon) return;

    submitButton.dataset.state = state;
    submitButton.disabled = state === "loading";
    submitButton.classList.remove("animate-success-pop", "animate-shake");

    if (state === "loading") {
      submitLabel.textContent = "Sending...";
    } else if (state === "success") {
      submitLabel.textContent = "Sent!";
      arrowIcon.classList.add("scale-50", "opacity-0");
      checkIcon.classList.remove("scale-50", "opacity-0");
      void submitButton.offsetWidth;
      submitButton.classList.add("animate-success-pop");
      burstConfetti();
    } else if (state === "error") {
      submitLabel.textContent = "Send message";
      void submitButton.offsetWidth;
      submitButton.classList.add("animate-shake");
    } else {
      submitLabel.textContent = "Send message";
      arrowIcon.classList.remove("scale-50", "opacity-0");
      checkIcon.classList.add("scale-50", "opacity-0");
    }
  }

  // If JS attached too late, the browser did a real POST to the form's
  // action/method fallback and we're back here after a redirect.
  const landedStatus = new URLSearchParams(window.location.search).get("contact");
  if (landedStatus === "success") {
    setButtonState("success");
    setStatus("Message sent, I'll get back to you soon.", "success");
    revertTimeout = setTimeout(() => setButtonState("idle"), 3000);
  } else if (landedStatus === "error") {
    setButtonState("error");
    setStatus("Something went wrong, please email me directly instead.", "error");
    revertTimeout = setTimeout(() => setButtonState("idle"), 3000);
  }
  if (landedStatus) {
    const url = new URL(window.location.href);
    url.searchParams.delete("contact");
    window.history.replaceState({}, "", url.pathname + url.search + url.hash);
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (revertTimeout) clearTimeout(revertTimeout);

    const name = (form.querySelector<HTMLInputElement>("#contact-name")?.value ?? "").trim();
    const email = (form.querySelector<HTMLInputElement>("#contact-email")?.value ?? "").trim();
    const message = (form.querySelector<HTMLTextAreaElement>("#contact-message")?.value ?? "").trim();
    const company = (form.querySelector<HTMLInputElement>("#contact-company")?.value ?? "").trim();
    const engagementType = form.querySelector<HTMLInputElement>('input[name="engagementType"]:checked')?.value ?? "";

    setButtonState("loading");

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, message, company, engagementType }),
      });

      if (!response.ok) {
        throw new Error("Request failed");
      }

      setButtonState("success");
      setStatus("Message sent, I'll get back to you soon.", "success");
      form.reset();
      revertTimeout = setTimeout(() => setButtonState("idle"), 3000);
    } catch {
      setButtonState("error");
      setStatus("Something went wrong, please email me directly instead.", "error");
      revertTimeout = setTimeout(() => setButtonState("idle"), 3000);
    }
  });
</script>

<style is:global>
  .confetti-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
  }

  #contact-confetti.is-active .confetti-dot {
    animation: confetti-pop 650ms ease-out forwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes confetti-pop {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.6);
    }
    100% {
      opacity: 0;
      transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(1);
    }
  }

  .animate-success-pop {
    animation: success-pop 420ms ease-out;
  }

  @keyframes success-pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  .animate-shake {
    animation: shake 420ms ease-in-out;
  }

  @keyframes shake {
    10%,
    90% {
      transform: translateX(-1px);
    }
    20%,
    80% {
      transform: translateX(2px);
    }
    30%,
    50%,
    70% {
      transform: translateX(-4px);
    }
    40%,
    60% {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .confetti-dot,
    .animate-success-pop,
    .animate-shake {
      animation: none !important;
    }
  }
</style>