---
const { pathname } = Astro.url;
const isHome = pathname === "/";
const isProjects = pathname.startsWith("/projects");
const isBlog = pathname.startsWith("/blog");
---

<nav
  id="mobile-menu"
  transition:persist
  class="pointer-events-none fixed top-20 right-5 z-[1000] flex min-w-44 flex-col rounded-2xl
         border border-neutral-950/10 dark:border-white/10 bg-white/80 dark:bg-neutral-950/30 backdrop-blur-xl shadow-[0_20px_25px_-5px_rgba(120,119,198,0.2),0_8px_10px_-6px_rgba(120,119,198,0.16)] dark:shadow-xl
         p-5 gap-y-4
         opacity-0 scale-95 -translate-y-2 origin-top-right
         transition-all duration-100 ease-out"
>
  <button
    type="button"
    class="theme-toggle flex items-center gap-1.5"
    aria-label="Toggle light/dark theme"
  >
    <svg class="hidden dark:block size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
      <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
      <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
    </svg>
    <svg class="block dark:hidden size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
      <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
    </svg>
    <span class="hidden dark:inline">Light mode</span>
    <span class="dark:hidden">Dark mode</span>
  </button>
  <a href="/" data-nav="home" aria-current={isHome ? "page" : undefined}>Home</a>
  <a href="/#experience">Experience</a>
  <a href="/#education">Education</a>
  <a href="/projects/" class="flex items-center gap-1.5" data-nav="projects" aria-current={isProjects ? "page" : undefined}>
    Projects
    <svg
      class="size-3.5"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M17 7l-10 10" />
      <path d="M8 7l9 0l0 9" />
    </svg>
  </a>
  <a href="/blog/" class="flex items-center gap-1.5" data-nav="blog" aria-current={isBlog ? "page" : undefined}>
    Blog
    <svg
      class="size-3.5"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M17 7l-10 10" />
      <path d="M8 7l9 0l0 9" />
    </svg>
  </a>
  <a href="/#about-me">About me</a>
  <a href="/#contact">Contact</a>
  <a href="/cv.pdf" download="Pablo-Garcia-Ruiz-CV.pdf" class="flex items-center gap-1.5">
    CV
    <svg
      class="size-3.5"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
      <path d="M7 11l5 5l5 -5" />
      <path d="M12 4l0 12" />
    </svg>
  </a>
</nav>

<script>
const syncActiveNav = () => {
  const path = window.location.pathname;
  const active: Record<string, boolean> = {
    home: path === "/",
    projects: path.startsWith("/projects"),
    blog: path.startsWith("/blog"),
  };

  document.querySelectorAll<HTMLElement>("[data-nav]").forEach((link) => {
    const key = link.dataset.nav;
    if (key && active[key]) {
      link.setAttribute("aria-current", "page");
    } else {
      link.removeAttribute("aria-current");
    }
  });
};

document.addEventListener("astro:page-load", () => {
  syncActiveNav();

  const button = document.querySelector<HTMLElement>("#menu-button");
  if (!button) return;

  // Header/menu are transition:persist'd, so this handler only needs to run once.
  if (button.dataset.menuBound === "true") return;
  button.dataset.menuBound = "true";

const menu = document.querySelector("#mobile-menu");
const middle = document.querySelector("#comment-middle");
const middleInner = document.querySelector("#comment-middle-inner");
const slashLeft = document.querySelector("#slash-left");

const GAP_DURATION = 200;
const ASTERISK_DURATION = 130;

let iconTimeout: ReturnType<typeof setTimeout> | undefined;

const setGap = (open: boolean) => {
  if (!middle) return;

  middle.classList.toggle("grid-cols-[1fr]", open);
  middle.classList.toggle("grid-cols-[0fr]", !open);

  middle.classList.toggle("overflow-visible", open);
  middle.classList.toggle("overflow-hidden", !open);

  middleInner?.classList.toggle("overflow-visible", open);
  middleInner?.classList.toggle("overflow-hidden", !open);

  slashLeft?.classList.toggle("translate-x-0.5", !open);
  slashLeft?.classList.toggle("translate-x-2", open);
};

const setAsterisks = (visible: boolean) => {
  middleInner?.classList.toggle("opacity-100", visible);
  middleInner?.classList.toggle("opacity-0", !visible);
};

const openMenu = () => {
  menu?.classList.remove("pointer-events-none", "opacity-0", "scale-95", "-translate-y-2");
  menu?.classList.add("opacity-100", "scale-100", "translate-y-0");
  button?.setAttribute("aria-expanded", "true");

  clearTimeout(iconTimeout);
  setAsterisks(false);
  setGap(true);
  iconTimeout = setTimeout(() => setAsterisks(true), GAP_DURATION);

  menu?.querySelector<HTMLAnchorElement>("a")?.focus();
};

const closeMenu = (returnFocus = false) => {
  menu?.classList.add("pointer-events-none", "opacity-0", "scale-95", "-translate-y-2");
  menu?.classList.remove("opacity-100", "scale-100", "translate-y-0");
  button?.setAttribute("aria-expanded", "false");

  clearTimeout(iconTimeout);
  setAsterisks(false);
  iconTimeout = setTimeout(() => setGap(false), ASTERISK_DURATION);

  if (returnFocus) (button as HTMLElement | null)?.focus();
};

const isMenuOpen = () => menu?.classList.contains("opacity-100") ?? false;

button?.addEventListener("click", () => {
  isMenuOpen() ? closeMenu() : openMenu();
});

document.addEventListener("keydown", (event) => {
  if (event.key === "Escape" && isMenuOpen()) closeMenu(true);
});

document.addEventListener("click", (event) => {
  if (!isMenuOpen()) return;
  const target = event.target as Node;
  if (menu?.contains(target) || button?.contains(target)) return;
  closeMenu();
});

menu?.querySelectorAll("a").forEach((link) => {
  link.addEventListener("click", () => closeMenu());
});
});
</script>