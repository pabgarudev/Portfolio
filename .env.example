# Copy this file to .env for local development.
# In Vercel, set these as Project > Settings > Environment Variables instead.

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# Address contact form submissions are sent to (defaults to pabgarudev@gmail.com if unset)
CONTACT_TO_EMAIL=

# Upstash Redis, backing the per-IP throttle on /api/contact (3 per 10 minutes).
# Attaching Upstash from the Vercel marketplace injects KV_REST_API_URL /
# KV_REST_API_TOKEN instead; either pair works.
# Leave both blank locally: the throttle falls back to a per-instance in-memory
# counter, which is fine for dev but must not be relied on in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
